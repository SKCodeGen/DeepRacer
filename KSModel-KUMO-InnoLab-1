def rewardByWayPointsAndHeading(params):
    
    import math
    
    waypoints = params['waypoints']
    closest_waypoints = params['closest_waypoints']
    heading = params['heading']
    # Calculate the direction of the center line based on the closest waypoints
    next_point = waypoints[closest_waypoints[1]]
    prev_point = waypoints[closest_waypoints[0]]

	# Calculate the direction in radius, arctan2(dy, dx), the result is (-pi, pi) in radians
    track_direction = math.atan2(next_point[1] - prev_point[1], next_point[0] - prev_point[0])
	
    print("track_direction in radians :" + str(track_direction))
	# Convert to degree
    track_direction = math.degrees(track_direction)
    
    print("track_direction in degrees :" + str(track_direction))
    print("heading param :" + str(heading))
    
    if heading > 180 and heading < 270 :
        heading = 180 - heading
    elif heading >= 270 :
        heading = 360 - heading
    
    print("heading param after conversion:" + str(heading))
	# Calculate the difference between the track direction and the heading direction of the car
    direction_diff = abs(track_direction - heading)
    
    print("next_point1 :" + str(next_point[1]) +"prev_point1"+ str(prev_point[1]))
    print("next_point0 :" + str(next_point[0]) +"prev_point0"+ str(prev_point[0]))
    return direction_diff
