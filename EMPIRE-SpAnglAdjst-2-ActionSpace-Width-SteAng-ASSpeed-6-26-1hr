def findCurve(params):
    
    import math
    
    waypoints = params['waypoints']
    closest_waypoints = params['closest_waypoints']
    xparam = params['x']
    yparam = params['y']
    
    closestCoordinates = getClosestCoordinates(params)
    prev_point = closestCoordinates[0]
    next_point = closestCoordinates[1]
    
    print("closest_waypoints :" + str(closest_waypoints))
    print("prev_point x0:" + str(prev_point[0]))
    print("prev_point y1:" + str(prev_point[1]))
    print("next_point x0:" + str(next_point[0]))
    print("next_point y1:" + str(next_point[1]))
    
    track_direction1 = math.atan2(next_point[1] - prev_point[1], next_point[0] - prev_point[0])
	
    print("track_direction1 in radians :" + str(track_direction1))
	# Convert to degree
    track_direction1 = math.degrees(track_direction1)
    print("track_direction1 in degrees :" + str(track_direction1))
    
    nextNextClosestCoordinate = getNextWayPoint(next_point[0], next_point[1], params)
    track_direction2 = math.atan2(nextNextClosestCoordinate[1] - next_point[1], nextNextClosestCoordinate[0] - next_point[0])
	
    print("track_direction2 in radians :" + str(track_direction2))
	# Convert to degree
    track_direction2 = math.degrees(track_direction2)
    print("track_direction2 in degrees :" + str(track_direction2))
    
    track_direction_diff = abs(track_direction1) - abs(track_direction2)
    print("track_direction_diff :"+ str(track_direction_diff))
    
    return track_direction_diff

def getClosestCoordinates(params):
    waypoints = params['waypoints']
    xparam = params['x']
    yparam = params['y']
    currentCoordinate = (xparam, yparam)
    print("getClosestCoordinates/currentCoordinate :" + str(currentCoordinate))
    
    i = 0
    for i in range (0,(len(waypoints)-1)):
        if(i == 70):
            nextCoordinate = waypoints[0]
        else:
            nextCoordinate = waypoints[i+1]
        
        coordinate = waypoints[i]
        closestCoordinates = [coordinate, nextCoordinate]
        if((xparam < coordinate[0] and xparam > nextCoordinate[1]) or (xparam > coordinate[0] and xparam < nextCoordinate[1])):
            break
        i += 1
    
    print("getClosestCoordinates/closestCoordinates :" + str(closestCoordinates))
    return closestCoordinates

def getPositionOfCoordinateInWaypoints(x, y, params):
    waypoints = params['waypoints']
    i = 0
    for i in range (0,(len(waypoints)-1)):
        coordinate = waypoints[i]
        if(coordinate[0] == x and coordinate[1] == y):
            break
        i += 1
        
    print("getPositionOfCoordinateInWaypoints / coordinate :" + str(waypoints[i]))
    print("coordinate index :" + str(i))
    return i
    
def getNextWayPoint(x, y, params):
    waypoints = params['waypoints']
    maxIndexPosition = len(waypoints)-1
    
    indexForCoordinate = getPositionOfCoordinateInWaypoints(x, y, params)
    nextClosestCoordinate = 0
    if (indexForCoordinate == maxIndexPosition):
        nextClosestCoordinate = waypoints[5]
    else:
        nextClosestCoordinate = waypoints[indexForCoordinate+5]
    return nextClosestCoordinate
    
def rewardByWayPointsAndHeading(params):
    
    import math
    
    waypoints = params['waypoints']
